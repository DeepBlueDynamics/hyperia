# Topology A secrets. Copy to .env (gitignored) and fill in.
# Only the Ghost agent needs this; terminal/MCP tools work without it.
ANTHROPIC_API_KEY=

# Do NOT set HYPERIA_SYSTEM_TOKEN. It is a consent-bypass identity, not an
# auth lock — Electron mints its own over loopback. Leaving it here as a
# warning, intentionally commented out:
# HYPERIA_SYSTEM_TOKEN=   # <-- leave unset
